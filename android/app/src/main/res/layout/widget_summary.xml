<?xml version="1.0" encoding="utf-8"?>
<!-- Widget 3x1: tre blocchi concettuali senza separatori. Sinistra: mood dell'ultima settimana.
     Centro: ultima nota (giorno e ora di fine). Destra: pulsante "Nuova nota".
     I due blocchi di testo hanno la STESSA struttura e altezze fisse (didascalia / valore / riga sotto),
     così le didascalie stanno alla stessa altezza e i valori hanno la stessa dimensione. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:clipChildren="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:padding="4dp">

    <LinearLayout
        android:clipChildren="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="8dp">

        <!-- 1. Mood dell'ultima settimana -->
        <LinearLayout
            android:id="@+id/sum_block_mood"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="13dp"
                android:fontFamily="casual"
                android:gravity="center"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="@string/widget_mood_caption"
                android:textColor="#7a6f5b"
                android:textSize="10sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <!-- quadratino di carta: ombra storta dietro + foglietto tinto col colore del mood -->
                <FrameLayout
                    android:layout_width="16dp"
                    android:layout_height="16dp">

                    <ImageView
                        android:layout_width="13dp"
                        android:layout_height="13dp"
                        android:layout_gravity="center"
                        android:contentDescription="@null"
                        android:rotation="5"
                        android:src="@drawable/widget_paper_shadow" />

                    <ImageView
                        android:id="@+id/sum_mood_dot"
                        android:layout_width="13dp"
                        android:layout_height="13dp"
                        android:layout_gravity="center"
                        android:layout_marginBottom="1dp"
                        android:layout_marginEnd="1dp"
                        android:contentDescription="@null"
                        android:rotation="-4"
                        android:src="@drawable/widget_paper_square"
                        android:tint="#b9b4a8" />
                </FrameLayout>

                <TextView
                    android:id="@+id/sum_mood_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="casual"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:paddingStart="5dp"
                    android:text="—"
                    android:textColor="#3a3226"
                    android:shadowColor="#3a3226"
                    android:shadowDx="1.3"
                    android:shadowDy="1.0"
                    android:shadowRadius="0.8"
                    android:textSize="21sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/sum_mood_sub"
                android:layout_width="wrap_content"
                android:layout_height="14dp"
                android:ellipsize="end"
                android:fontFamily="casual"
                android:gravity="center"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textColor="#4a4132"
                    android:shadowColor="#4a4132"
                    android:shadowDx="0.9"
                    android:shadowDy="0.7"
                    android:shadowRadius="0.6"
                android:textSize="10sp" />
        </LinearLayout>

        <!-- 2. Ultima nota: giorno e ora di fine -->
        <LinearLayout
            android:id="@+id/sum_block_last"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="13dp"
                android:fontFamily="casual"
                android:gravity="center"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="@string/widget_last_caption"
                android:textColor="#7a6f5b"
                android:textSize="10sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/sum_last_day"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="casual"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text="—"
                    android:textColor="#3a3226"
                    android:shadowColor="#3a3226"
                    android:shadowDx="1.3"
                    android:shadowDy="1.0"
                    android:shadowRadius="0.8"
                    android:textSize="21sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/sum_last_sub"
                android:layout_width="wrap_content"
                android:layout_height="14dp"
                android:ellipsize="end"
                android:fontFamily="casual"
                android:gravity="center"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textColor="#4a4132"
                    android:shadowColor="#4a4132"
                    android:shadowDx="0.9"
                    android:shadowDy="0.7"
                    android:shadowRadius="0.6"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- 3. Nuova nota: un vero pulsante in rilievo, appeso a un chiodo. Ogni tanto ondeggia attorno a quel
             solo punto: il ViewFlipper alterna due copie IDENTICHE del pulsante e l'animazione di ingresso
             (anim/widget_swing, pivot in alto al centro) è l'oscillazione smorzata. flipInterval = pausa fra
             un'oscillazione e l'altra. -->
        <LinearLayout
            android:id="@+id/sum_block_new"
            android:clipChildren="false"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0.9"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="7dp"
                android:layout_height="7dp"
                android:layout_marginBottom="-3dp"
                android:contentDescription="@null"
                android:src="@drawable/widget_nail" />

            <ViewFlipper
                android:id="@+id/sum_flipper"
                android:clipChildren="false"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:autoStart="true"
                android:flipInterval="7400"
                android:inAnimation="@anim/widget_swing">

                <LinearLayout
                    android:id="@+id/sum_btn_new"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/widget_button"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingBottom="9dp"
                    android:paddingLeft="10dp"
                    android:paddingRight="10dp"
                    android:paddingTop="6dp"
                    android:rotation="2">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="casual"
                        android:includeFontPadding="false"
                        android:text="+"
                        android:textColor="#3a3226"
                        android:textSize="24sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="casual"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:text="@string/widget_new_note"
                        android:textColor="#3a3226"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/sum_btn_new2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/widget_button"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingBottom="9dp"
                    android:paddingLeft="10dp"
                    android:paddingRight="10dp"
                    android:paddingTop="6dp"
                    android:rotation="2">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="casual"
                        android:includeFontPadding="false"
                        android:text="+"
                        android:textColor="#3a3226"
                        android:textSize="24sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="casual"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:text="@string/widget_new_note"
                        android:textColor="#3a3226"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </ViewFlipper>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
