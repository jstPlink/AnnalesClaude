<?xml version="1.0" encoding="utf-8"?>
<!-- Chiodo a cui è "appeso" il pulsante Nuova nota: testa scura con un puntino di luce -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <solid android:color="#5c5242" />
            <stroke android:width="1dp" android:color="#3a3226" />
        </shape>
    </item>
    <item
        android:bottom="3dp"
        android:left="1.5dp"
        android:right="3dp"
        android:top="1.5dp">
        <shape android:shape="oval">
            <solid android:color="#b9b0a0" />
        </shape>
    </item>
</layer-list>
