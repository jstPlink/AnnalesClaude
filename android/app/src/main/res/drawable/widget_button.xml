<?xml version="1.0" encoding="utf-8"?>
<!-- Pulsante in rilievo: ombra piena sotto + faccia gialla (colore della matita) con bordo -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#b8892a" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <item android:bottom="3dp">
        <shape android:shape="rectangle">
            <solid android:color="#e9b949" />
            <corners android:radius="14dp" />
            <stroke android:width="1dp" android:color="#c99a2e" />
        </shape>
    </item>
</layer-list>
