# Copia in `.env` SOLO se vuoi puntare l'app a un PocketBase esterno.
#
# Default (variabile non impostata): la stessa origin dell'app. In produzione
# nginx inoltra /api/ al container PocketBase interno; con `npm run dev` lo fa
# il proxy di Vite verso lo stack Docker locale (porta 8973, o VITE_DEV_API).
# VITE_PB_URL=https://pb.tuodominio.it
