# Copia in `.env` per sovrascrivere l'URL di PocketBase in sviluppo locale.
# Default (se non impostata): http://localhost:28090 — il PocketBase bundled
# avviato con `docker compose up` (vedi docker-compose.yml / pb_migrations/).
# Porta volutamente "strana" per non collidere con altri servizi sulla stessa
# macchina/NAS (8090 e' un default molto comune).
VITE_PB_URL=http://localhost:28090
